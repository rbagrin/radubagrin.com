// Prisma schema for the personal app.
// Run `npx prisma migrate dev` locally against Neon to create these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URLs no longer live here as of Prisma 7 — the CLI reads
  // them from prisma.config.ts, and PrismaClient gets one via a driver
  // adapter (see lib/db.ts).
}

// Placeholder user model so auth + per-user data (reminders, watchlists, etc.)
// has somewhere to attach to. Extend this as real auth is wired in.
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  createdAt DateTime   @default(now())
  reminders Reminder[]
  rssFeeds  RssFeed[]
  todoLists TodoList[]
  todoItems TodoItem[]
  skills    Skill[]

  @@map("users")
}

// Jarvis module — User-registered skills & tools accessible via MCP
model Skill {
  id                  String   @id @default(cuid())
  userId              String
  name                String   // Unique identifier e.g. "fetch_weather"
  displayName         String   // Human-readable title
  description         String   // Prompt description for LLM tool calling
  parameters          Json     // JSON Schema parameter definition
  type                String   @default("webhook") // "webhook" | "internal" | "mcp_endpoint"
  config              Json     // { url, method, headers }
  encryptedSecret     String?  // AES-256-GCM encrypted API key/auth token
  requireConfirmation Boolean  @default(false)
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("skills")
}

// RSS Aggregator module — saved RSS feed URLs per user.
model RssFeed {
  id        String   @id @default(cuid())
  userId    String
  name      String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, url])
  @@index([userId])
  @@map("rss_feeds")
}

// Reminders module — real schema, seeded with dummy data for now via the API mock.
model Reminder {
  id        String   @id @default(cuid())
  userId    String
  title     String
  dueDate   DateTime
  notifyBy  String   @default("email") // "email" | "push"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminders")
  @@index([userId])
}

// Documents module — metadata storage for S3 files, RAG embeddings & chunking state.
model Document {
  id         String   @id @default(cuid())
  name       String
  s3Key      String   @unique
  folderPath String   @default("")
  mimeType   String?
  size       Int
  metadata   Json?
  status     String   @default("uploaded") // e.g. "uploaded", "pending_embedding", "indexed", "error"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("documents")
  @@index([folderPath])
  @@index([status])
}

// Todo module — customizable todo lists and todo items per user.
model TodoList {
  id        String     @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items TodoItem[]

  @@index([userId])
  @@map("todo_lists")
}

model TodoItem {
  id        String   @id @default(cuid())
  listId    String
  userId    String
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todoList TodoList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([userId])
  @@map("todo_items")
}


